# ========================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ========================================
# PED Majevica 1988 - Development Configuration
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Update SECRET_KEY with a random value
# 3. Keep DATABASE_URL as SQLite for development
# 4. Update admin passwords if needed
#
# ========================================

# -----------------------------
# Flask Configuration
# -----------------------------
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# -----------------------------
# Database
# -----------------------------
# Development: SQLite (default)
DATABASE_URL=sqlite:///instance/ped.db

# Production: PostgreSQL (example)
# DATABASE_URL=postgresql://username:password@localhost:5432/pedmajevica

# -----------------------------
# Logging
# -----------------------------
LOG_LEVEL=DEBUG

# -----------------------------
# Security (Development)
# -----------------------------
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# -----------------------------
# File Upload
# -----------------------------
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# -----------------------------
# Email (Optional for dev)
# -----------------------------
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------
# Rate Limiting
# -----------------------------
RATELIMIT_ENABLED=False
RATELIMIT_DEFAULT=100 per hour

# -----------------------------
# Admin User Passwords
# -----------------------------
# REQUIRED FOR PRODUCTION:
# Set these environment variables in production
# Generate strong passwords (min 12 chars, mixed case, numbers, symbols)
#
# ADMIN_RADOVAN_PASSWORD=your-strong-password-here
# ADMIN_ALEKSANDAR_PASSWORD=your-strong-password-here
# ADMIN_SRECKO_PASSWORD=your-strong-password-here
# ADMIN_MILOJKO_PASSWORD=your-strong-password-here
#
# For development, you can set any values you want
# but NEVER use default passwords in production!
ADMIN_RADOVAN_PASSWORD=dev-password-change-in-production
ADMIN_ALEKSANDAR_PASSWORD=dev-password-change-in-production
ADMIN_SRECKO_PASSWORD=dev-password-change-in-production
ADMIN_MILOJKO_PASSWORD=dev-password-change-in-production
