[Unit]
Description=PED Majevica Flask Application (gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=pedmajevica
Group=pedmajevica
WorkingDirectory=/var/www/ped-majevica/backend
EnvironmentFile=/var/www/ped-majevica/backend/.env
Environment="PATH=/var/www/ped-majevica/backend/venv/bin"
ExecStart=/var/www/ped-majevica/backend/venv/bin/gunicorn -c /var/www/ped-majevica/deployment/configs/gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
